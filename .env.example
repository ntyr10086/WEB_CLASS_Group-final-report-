# 複製成 .env 再填入（.env 不要推上 GitHub）
SECRET_KEY=換成一串隨機字

# ── MongoDB ──────────────────────────────
# 本機：mongodb://localhost:27017
# Atlas：mongodb+srv://帳號:密碼@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# 留空就用記憶體暫存（重開伺服器資料會消失）
MONGO_URI=
MONGO_DB=flood_rush

# ── AI ───────────────────────────────────
# auto：有 OpenAI Key 先用 OpenAI，再試本機 Ollama，都不行用規則版
# ollama / openai：只用其中一個；off：全部規則版
AI_PROVIDER=auto

# 本機 Ollama（課堂 ch7）：先執行 ollama pull llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60

# OpenAI（雲端 Render 版用這個；留空就略過）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
